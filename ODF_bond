# if two IF are free for bond

apiVersion: nmstate.io/v1
kind: NodeNetworkConfigurationPolicy
metadata:
  name: bond1-storage-policy-master
spec:
  nodeSelector:
    node-role.kubernetes.io/master: ""
  desiredState:
    interfaces:
    - name: bond1
      description: Bond1 with ports ens4f1 and ens1f1 for storage network
      type: bond
      state: up
      ipv4:
        dhcp: true
        enabled: true
      link-aggregation:
        mode: active-backup
        options:
          miimon: '100'
        port:
        - ens4f1
        - ens1f1


